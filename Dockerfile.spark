# ─────────────────────────────────────────────────────────────────────────────
# Dockerfile for StreamDQ Spark Streaming Pipeline
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jdk-alpine AS builder

WORKDIR /app

# Install Python via packages (Alpine)
RUN apk add --no-cache python3 py3-pip

# Copy only requirements first for caching
COPY requirements.txt .

# Install Java dependencies (for Spark) and build tools
RUN apk add --no-cache bash

# Install setuptools first (required for building some packages)
RUN pip3 install --no-cache-dir --break-system-packages setuptools

# Install Python packages (use PySpark 3.5.x for stability)
RUN pip3 install --no-cache-dir --break-system-packages \
    pyspark==3.5.3 \
    pyarrow \
    pandas

# ── Runtime stage ────────────────────────────────────────────────────────────
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache bash python3 py3-pip

# StreamDQ source
COPY --from=builder /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH=$JAVA_HOME/bin:$PATH

# Install setuptools first
RUN pip3 install --no-cache-dir --break-system-packages setuptools

# Python packages (use PySpark 3.5.x for stability)
RUN pip3 install --no-cache-dir --break-system-packages \
    pyspark==3.5.3 \
    pyarrow \
    pandas \
    kafka-python \
    prometheus-client \
    requests \
    gtfs-realtime-bindings \
    psycopg2-binary \
    click

# Copy application source
COPY streamdq /app/streamdq
COPY config /app/config
WORKDIR /app

# Prometheus metrics are exposed via the built-in metrics thread on port 9090
# Run the Spark pipeline
CMD ["python3", "-m", "streamdq.pipeline.spark_pipeline"]
