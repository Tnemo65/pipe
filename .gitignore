# ============================================================
# StreamDQ .gitignore
# ============================================================

# ── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
ENV/
env/
.pyenv

# mypy / type stubs
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/

# ── Testing ────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# ── Data files (download on server, not in repo) ───────────
data/
data_raw/
data/processed/
data/output/
*.parquet
*.csv
*.db
duckdb/
*.sqlite
*.sqlite3

# NYC Taxi downloads
nyc_taxi_data/
yellow_tripdata_*.parquet

# GTFS cache
gtfs_cache/
.cache/

# ── Docker / images ────────────────────────────────────────
*.tar
*.tar.gz
*.image

# ── IDE / Editor ───────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Cursor (agent metadata, not project code)
.cursor/

# ── OS ─────────────────────────────────────────────────────
*.log
*.tmp
*.temp
*.bak
*.backup

# ── ML / Model outputs ─────────────────────────────────────
*.ckpt
*.h5
*.pkl
*.model
models/*.pkl
models/*.joblib

# ── Evaluation results (regenerate on each run) ──────────
evaluation_results.json
evaluation_results_*.json
*.eval.json

# ── Environment variables (NEVER commit real creds) ───────
.env

# ── Papers ───────────────────────────────────────────────
# paper-to-learn/  # UNCOMMENT to exclude large PDFs
# *.pdf
# *.pptx
# *.ppt

# ── Node / npm (if any) ───────────────────────────────────
node_modules/
package-lock.json

# ── NFS / mount placeholders ──────────────────────────────
# (mounted at runtime on server)
nfs_mounts/
mnt/

# ── Spark checkpoints (regenerate on each run) ────────────
spark-checkpoint/
checkpoint/
*.checkpoint

# ── Secrets placeholder ───────────────────────────────────
# Keep .env.example but NOT .env
*.pem
*.key
credentials.json
secrets.json
token.json

# ── Compiled / binary ─────────────────────────────────────
*.so
*.dylib
*.dll
*.exe

# ── Scratch / temp scripts ────────────────────────────────
scripts/fix_ng33*.py
*.scratch.py
temp_*.py
